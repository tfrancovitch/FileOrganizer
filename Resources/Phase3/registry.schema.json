  "value.desired_location": {
   "additionalProperties": false,
   "description": "A literal destination (P3-A126): a project source root's id and a root-relative folder, byte-exact; a collision is never resolved silently (on_collision is 'fail', P3-A134). That the root is a current source root, that no segment is an existing file and the spelling of an existing folder are the store's, from the evidence.",
   "properties": {
