{
 "$defs": {
  "decision": {
   "description": "A recorded decision: p3_decision's kind, target kind and value.",
   "oneOf": [
    {
     "$ref": "#/$defs/decision.must_keep_location"
    },
    {
     "$ref": "#/$defs/decision.keep_all_group"
    },
    {
     "$ref": "#/$defs/decision.canonical_location"
    },
    {
     "$ref": "#/$defs/decision.redundant_location"
    },
    {
     "$ref": "#/$defs/decision.defer_review"
    },
    {
     "$ref": "#/$defs/decision.override_protection"
    },
    {
     "$ref": "#/$defs/decision.equivalent_copy"
    },
    {
     "$ref": "#/$defs/decision.related_variant"
    },
    {
     "$ref": "#/$defs/decision.different"
    },
    {
     "$ref": "#/$defs/decision.keep_both"
    },
    {
     "$ref": "#/$defs/decision.project_metadata_set"
    },
    {
