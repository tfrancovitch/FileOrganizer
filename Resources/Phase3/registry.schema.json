   "x-fo-supersedable": true
  },
  "decision.related_variant": {
   "description": "Meaningfully related but NOT interchangeable (a deliberate crop, a black-and-white edit, a retouch, an annotated export). Its default retention is Keep Both, and it never falls into the ordinary redundant-copy cleanup.",
   "properties": {
    "decision_kind": {
     "const": "related_variant"
    },
    "origin_kind": {
     "enum": [
      "explicit_human",
      "bulk_explicit_human"
     ]
    },
    "target_kind": {
