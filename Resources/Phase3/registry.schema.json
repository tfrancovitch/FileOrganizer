    "destination_folder",
    "on_collision"
   ],
   "type": "object"
  },
  "value.desired_name": {
   "additionalProperties": false,
   "description": "A literal file name (P3-A126), refused at record time when Windows cannot hold it (P3-A142). An extension change needs extension_change_confirmed = true -- checked by the store against the observed name.",
