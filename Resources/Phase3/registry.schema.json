  },
  "effect.none": {
   "description": "No parameters (an object's other keys are not read).",
   "type": [
    "object",
    "null"
   ]
  },
  "effect.prefer_folder_subtree": {
   "description": "Optionally 'over' one other folder: over_path_key (non-blank text) and its display text over.",
   "if": {
    "properties": {
     "over_path_key": {
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "over_path_key"
    ],
    "type": "object"
   },
   "properties": {
    "over_path_key": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "const": ""
      },
      {
       "$ref": "#/$defs/nonblank_text"
      }
     ]
    }
   },
   "then": {
    "properties": {
     "over": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   },
   "type": [
    "object",
    "null"
   ]
  },
  "field_value.date": {
   "description": "YYYY-MM-DD, or YYYY-MM-DDTHH:MM[:SS][Z|+HH:MM|-HH:MM]: a real calendar day (0001-9999), times 00:00-23:59:59, offsets up to 23:59.",
   "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028-\\u2029\\u202f\\u205f\\u3000]*(?!0000)(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)(?:T(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9])?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])?)?[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028-\\u2029\\u202f\\u205f\\u3000]*$",
   "type": "string"
  },
  "field_value.keyword_list": {
   "description": "A non-empty list of keywords, each non-blank text.",
   "items": {
    "$ref": "#/$defs/field_value.text"
   },
   "minItems": 1,
   "type": "array"
  },
  "field_value.text": {
   "description": "Non-blank text, at most 4,000 characters once surrounding whitespace is removed.",
   "not": {
    "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028-\\u2029\\u202f\\u205f\\u3000][\\s\\S]{3999,}[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028-\\u2029\\u202f\\u205f\\u3000]"
   },
   "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028-\\u2029\\u202f\\u205f\\u3000]",
   "type": "string"
  },
  "id": {
   "anyOf": [
    {
     "type": "integer"
    },
    {
     "$ref": "#/$defs/nonblank_text"
    }
   ],
   "description": "A policy or policy-version id: an integer, or non-blank text."
  },
  "nonblank_text": {
   "description": "Text with at least one character that is not whitespace.",
   "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028-\\u2029\\u202f\\u205f\\u3000]",
   "type": "string"
  },
  "path.folder": {
   "description": "A folder relative to a project source root: legal Windows names joined by a backslash, each at most 255 UTF-16 code units; '' is the root itself. No drive letter, no leading separator, no '.' or '..'.",
   "pattern": "^(?:(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9\\u00b9\\u00b2\\u00b3]|[Ll][Pp][Tt][1-9\\u00b9\\u00b2\\u00b3]) *(?:[.]|$))[^<>:\"/\\\\|?*\\u0000-\\u001f]*[^<>:\"/\\\\|?*\\u0000-\\u001f .](?:[\\\\](?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9\\u00b9\\u00b2\\u00b3]|[Ll][Pp][Tt][1-9\\u00b9\\u00b2\\u00b3]) *(?:[.]|$))[^<>:\"/\\\\|?*\\u0000-\\u001f]*[^<>:\"/\\\\|?*\\u0000-\\u001f .])*)?$",
   "type": "string",
   "x-fo-max-utf16-units": {
    "max": 255,
    "split": "\\"
   }
  },
  "path.name": {
   "description": "One legal Windows file name, at most 255 UTF-16 code units (never '.' or '..').",
