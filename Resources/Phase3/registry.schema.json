   "x-fo-requires-evidence": true,
   "x-fo-resolution-class": "none",
   "x-fo-supersedable": true
  },
  "decision.desired_location": {
   "description": "Where you want this file to be: a literal folder, relative to a project source root. Stored in the project; never moves the file. Plans as Move location; every such item stays blocked until Phase 4 certifies an executor.",
