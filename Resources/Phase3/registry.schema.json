    }
   ],
   "properties": {
    "decision_kind": {
     "enum": [
      "must_keep_location",
      "keep_all_group",
      "canonical_location",
      "redundant_location",
      "defer_review",
      "override_protection",
      "equivalent_copy",
      "related_variant",
      "different",
      "keep_both",
      "project_metadata_set",
      "desired_source_metadata_set",
      "desired_source_metadata_clear",
      "leave_source_metadata_unchanged",
      "desired_location",
      "desired_name"
     ]
    }
   },
   "required": [
    "decision_kind",
    "target_kind",
    "value"
   ],
   "type": "object"
  },
  "decision.canonical_location": {
   "description": "Which copy represents the group -- or, on a visual candidate pair, which of the two is preferred (Prefer Left / Prefer Right). Optional; the canonical is always a keeper. It says nothing about which copy came first.",
   "properties": {
    "decision_kind": {
     "const": "canonical_location"
    },
    "origin_kind": {
     "enum": [
      "explicit_human",
      "bulk_explicit_human"
     ]
    },
    "target_kind": {
     "enum": [
      "exact_duplicate_group_version",
      "visual_candidate_pair"
     ]
    },
    "value": {
     "$ref": "#/$defs/value.location_ref"
    }
   },
   "required": [
    "decision_kind",
    "target_kind",
    "value"
   ],
   "title": "Set canonical",
   "type": "object",
   "x-fo-affects-reclaim": true,
   "x-fo-confirmation": "none",
   "x-fo-conflict-domain": "group_canonical",
   "x-fo-requires-evidence": true,
   "x-fo-resolution-class": "explicit_location_decision",
   "x-fo-supersedable": true
  },
  "decision.defer_review": {
   "description": "An explicit, durable 'not deciding yet'. Distinct from a retention decision and from merely having looked.",
   "properties": {
    "decision_kind": {
     "const": "defer_review"
    },
    "origin_kind": {
     "enum": [
      "explicit_human",
      "bulk_explicit_human"
     ]
    },
    "target_kind": {
     "enum": [
      "exact_duplicate_group_version",
      "file_location"
     ]
    },
    "value": {
     "$ref": "#/$defs/value.flag"
