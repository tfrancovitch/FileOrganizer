{
 "axioms": [
  {
   "fixtures": [
    "F17"
   ],
   "id": "P3-A125",
   "status": "tested",
   "text": "A desired location or name is recorded in Phase 3. Only Phase 4 changes the namespace.",
   "title": "Organizing intent is a Decision; moving or renaming is an action"
  },
  {
   "fixtures": [
    "F18",
    "F19",
    "F28"
   ],
   "id": "P3-A126",
   "status": "tested",
   "text": "A decision stores a resolved destination or name, never a template, rule or scheme reference.",
   "title": "Phase 3 organizing values are literal"
  },
  {
   "fixtures": [
    "F18",
    "F19"
   ],
   "id": "P3-A127",
   "status": "corollary of A126 (templates are deferred): one closeout row pointing at A126's test",
   "text": "A template is evaluated once, against stored evidence, and its per-target output becomes literal decisions. The template string is batch provenance only.",
   "title": "Templates are entry aids frozen at preview"
  },
  {
   "fixtures": [],
   "id": "P3-A128",
   "status": "deferred with F30 (the template expander is not built): no Phase 3 check",
   "text": "Only a `known` value fills a token. Any other value-state leaves the target undecided and visible. A fallback exists only as a literal the person typed for a counted bucket.",
   "title": "An unknown template field excludes the target"
  },
  {
   "fixtures": [
    "F18",
    "F19"
   ],
   "id": "P3-A129",
   "status": "corollary of A126: one closeout row pointing at A126's test",
   "text": "\"Files matching X go to Y\" acts on future matches. It is a Phase 7 organizational model, not a Phase 3 decision.",
   "title": "Phase 3 has no dynamic organizing policy"
  },
  {
   "fixtures": [],
   "id": "P3-A130",
   "status": "principle (restates principle 6): one row, no new test",
   "text": "A desired location neither makes a Keeper nor protects nor removes. A Keeper or a canonical is never moved because of its retention status.",
   "title": "Organizing is not retention"
  },
  {
   "fixtures": [
    "F22"
   ],
   "id": "P3-A131",
   "status": "tested",
   "text": "Both items are blocked as conflicting intent until a person withdraws one. Neither wins automatically.",
   "title": "Removal and organizing intent on one location never both plan"
  },
  {
   "fixtures": [
    "F23"
   ],
   "id": "P3-A132",
   "status": "tested",
   "text": "A covered location is not moved or renamed without the existing `override_protection` naming the policy version. Moving into protection is a warning.",
   "title": "Protection gates organizing as it gates removal"
  },
  {
   "fixtures": [
    "F24",
    "F37"
   ],
   "id": "P3-A133",
   "status": "tested",
   "text": "Detected companions are recorded as their own human decisions in the same operation. A plan that would strand a known companion is blocked.",
   "title": "Families travel together, explicitly"
  },
  {
   "fixtures": [
    "F20",
    "F28"
   ],
   "id": "P3-A134",
   "status": "tested",
   "text": "Fail is the default and the only initial policy. Renaming, replacing, skipping or discarding on collision requires an explicit decision value.",
   "title": "A collision policy that changes the outcome is intent"
  },
  {
   "fixtures": [
    "F21",
    "F34"
   ],
   "id": "P3-A135",
   "status": "tested",
   "text": "Outside a usable walk it is unknown, and unknown blocks. Phase 4 re-checks it live.",
   "title": "Destination occupancy is judged against project evidence"
  },
  {
   "fixtures": [
    "F25",
    "F27"
   ],
   "id": "P3-A136",
   "status": "tested",
   "text": "Cross-volume, cycle and executor-unsupported items are built, previewed and blocked with a named reason, never dropped.",
   "title": "Unsupported moves stay visible"
  },
  {
   "fixtures": [
    "F21"
   ],
   "id": "P3-A137",
   "status": "tested",
   "text": "Cloud-only sources, or sources whose cloud state is unknown, block organize items in Phase 3.",
   "title": "Organizing never hydrates"
  },
  {
   "fixtures": [
    "F20",
    "F41"
   ],
   "id": "P3-A138",
   "status": "tested",
   "text": "Plans and fingerprints store destination strings as entered. Collision detection compares through the path-matching rule and errs toward a collision.",
   "title": "Destinations are byte-exact, collisions conservative"
  },
  {
   "fixtures": [
    "F26"
   ],
   "id": "P3-A139",
   "status": "tested (asserts a file renamed outside the product is never matched by name)",
   "text": "After an executed move, decisions follow the file only through a Phase 4 succession record confirmed by identity. Phase 3 never matches by name.",
   "title": "Location succession is evidence, not inference"
  },
  {
   "fixtures": [],
   "id": "P3-A140",
   "status": "principle; no fixture can test it: Met -- principle; no check",
   "text": "Taxonomies, file plans and many-valued classification belong to project metadata now and organizational models in Phase 7. A file has one folder but may have many categories.",
   "title": "Classification is not location"
  },
  {
   "fixtures": [
    "A141"
   ],
   "id": "P3-A141",
   "status": "tested (the store refuses any other origin)",
   "text": "Only human acceptance records organizing intent (axiom 17).",
   "title": "Machine destination suggestions remain suggestions"
  },
  {
   "fixtures": [
    "F28"
   ],
   "id": "P3-A142",
   "status": "tested",
   "text": "A name Windows cannot hold is a value error at record time, not blocked intent.",
   "title": "Invalid names are refused, not recorded"
  },
  {
   "fixtures": [],
   "id": "P3-A143",
   "status": "principle; no fixture can test it: Met -- principle; no check",
   "text": "Control or production numbers are project metadata or properties of derived copies. Source names are provenance.",
   "title": "Renaming originals to identifiers is not organizing"
  },
  {
   "fixtures": [
    "F23",
    "F31"
   ],
   "id": "P3-A144",
   "status": "tested (new, both directions)",
   "text": "override_protection names the policy it defeats AND the action it lifts it for (removal or organize). A removal-scope override never lets a move or rename through; an organize-scope one never lets a removal take effect. A removal scope is stored with no member, so every earlier row reads as removal.",
   "title": "An override lifts protection for one action only"
  },
  {
   "fixtures": [
    "F34"
   ],
   "id": "P3-A145",
   "status": "tested (new)",
   "text": "A destination is free only where the latest walk saw the destination folder and every ancestor up to the root: no inaccessible entry, no skipped link (reparse directory), no truncated list. An empty or unusable walk is not free; it is unknown, and unknown blocks.",
   "title": "'Known free' requires complete coverage of the destination folder chain"
  }
 ],
